{
 "slug": "textbundle-files",
 "module": "textbundle-files/src/bundle",
 "function": "bundleFromFiles",
 "note": "Each case names its function in fn. bundle(fileName, files) and pack(fileName, files) take text file contents; the test encodes them as UTF-8 (pack also zips them with fflate) and gives {name, textName, text, type, markdown, assets, warnings}. rewriteImportLinks(text, assetPath to vaultPath), exportLinks(text, link target to vaultPath), roundTrip(text, assetPath to vaultPath) runs import then export with the reverse map. infoRoundTrip(text, info) gives the stored text and the result of takeInfoProperty. Names that start with A and a number are acceptance cases of SPEC.md. Reviewed by hand against each input.",
 "cases": [
  {
   "name": "A1 pack with text.markdown, info.json and assets gives note name, text and asset list",
   "fn": "bundle",
   "args": [
    "Trip notes.textpack",
    {
     "info.json": "{\"version\":2,\"type\":\"net.daringfireball.markdown\",\"creatorIdentifier\":\"net.shinyfrog.bear\"}",
     "text.markdown": "# Trip\n\n![](assets/map.png)\n",
     "assets/map.png": "PNG"
    }
   ],
   "expected": {
    "name": "Trip notes",
    "textName": "text.markdown",
    "text": "# Trip\n\n![](assets/map.png)\n",
    "type": "net.daringfireball.markdown",
    "markdown": true,
    "assets": [
     "map.png"
    ],
    "warnings": []
   }
  },
  {
   "name": "A1 import rewrites an image link to the vault attachment path",
   "fn": "rewriteImportLinks",
   "args": [
    "# Trip\n\n![](assets/map.png)\n",
    {
     "map.png": "Attachments/map.png"
    }
   ],
   "expected": {
    "text": "# Trip\n\n![](Attachments/map.png)\n",
    "rewritten": 1,
    "missing": 0
   }
  },
  {
   "name": "A2 text.md inside one top folder Name.textbundle is found",
   "fn": "bundle",
   "args": [
    "Ulysses sheet.textpack",
    {
     "Ulysses sheet.textbundle/info.json": "{\"version\":2}",
     "Ulysses sheet.textbundle/text.md": "Hello",
     "Ulysses sheet.textbundle/assets/a.jpg": "J"
    }
   ],
   "expected": {
    "name": "Ulysses sheet",
    "textName": "text.md",
    "text": "Hello",
    "type": "net.daringfireball.markdown",
    "markdown": true,
    "assets": [
     "a.jpg"
    ],
    "warnings": []
   }
  },
  {
   "name": "A2 text.markdown wins over text.md and the bundle warns",
   "fn": "bundle",
   "args": [
    "Two.textbundle",
    {
     "text.md": "md",
     "text.markdown": "markdown",
     "info.json": "{\"version\":2}"
    }
   ],
   "expected": {
    "name": "Two",
    "textName": "text.markdown",
    "text": "markdown",
    "type": "net.daringfireball.markdown",
    "markdown": true,
    "assets": [],
    "warnings": [
     "The bundle has 2 text files. Imported text.markdown."
    ]
   }
  },
  {
   "name": "A2 no text file refuses the bundle",
   "fn": "bundle",
   "args": [
    "Empty.textpack",
    {
     "info.json": "{\"version\":2}",
     "assets/a.png": "x"
    }
   ],
   "expected": {
    "error": "No text file (text.markdown or text.md) in the bundle."
   }
  },
  {
   "name": "A2 __MACOSX and .DS_Store entries are ignored",
   "fn": "bundle",
   "args": [
    "Mac.textpack",
    {
     "__MACOSX/Mac.textbundle/._text.markdown": "junk",
     "Mac.textbundle/.DS_Store": "junk",
     "Mac.textbundle/text.markdown": "Body",
     "Mac.textbundle/info.json": "{\"version\":2}"
    }
   ],
   "expected": {
    "name": "Mac",
    "textName": "text.markdown",
    "text": "Body",
    "type": "net.daringfireball.markdown",
    "markdown": true,
    "assets": [],
    "warnings": []
   }
  },
  {
   "name": "A3 missing info.json gives version 2 and the Markdown type",
   "fn": "parseInfo",
   "args": [
    null
   ],
   "expected": {
    "info": {
     "version": 2,
     "type": "net.daringfireball.markdown",
     "raw": null
    },
    "warning": "No info.json. Used the Markdown type."
   }
  },
  {
   "name": "A3 bad info.json JSON gives the defaults and a warning",
   "fn": "parseInfo",
   "args": [
    "{version: 2"
   ],
   "expected": {
    "info": {
     "version": 2,
     "type": "net.daringfireball.markdown",
     "raw": null
    },
    "warning": "info.json is not valid JSON. Used the Markdown type."
   }
  },
  {
   "name": "A3 version 1 info.json without type defaults to Markdown",
   "fn": "parseInfo",
   "args": [
    "{\"version\":1,\"transient\":true}"
   ],
   "expected": {
    "info": {
     "version": 1,
     "type": "net.daringfireball.markdown",
     "raw": {
      "version": 1,
      "transient": true
     }
    },
    "warning": null
   }
  },
  {
   "name": "A3 pack without info.json still imports with a warning",
   "fn": "bundle",
   "args": [
