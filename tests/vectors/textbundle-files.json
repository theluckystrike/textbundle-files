    {
     "text.markdown": "x"
    }
   ],
   "expected": {
    "name": "Bare",
    "textName": "text.markdown",
    "text": "x",
    "type": "net.daringfireball.markdown",
    "markdown": true,
    "assets": [],
    "warnings": [
     "No info.json. Used the Markdown type."
    ]
   }
  },
